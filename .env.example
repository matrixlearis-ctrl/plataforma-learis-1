# Credenciais do Mercado Pago
VITE_MERCADOPAGO_PUBLIC_KEY=sua_public_key_aqui

# Nota: O ACCESS_TOKEN não deve ficar no frontend. 
# Ele deve ser configurado no painel do Supabase (Edge Functions) como segredo.

# Núcleo Social — Fase 4.1
# Override opcional para apontar o front ao STAGING durante os testes de dev.
# Se omitido, o lib/supabase.ts usa o projeto configurado (padrão).
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Edge Function r2-upload (Cloudflare R2) — configuradas como secrets no Supabase:
#   R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET / R2_PUBLIC_URL
